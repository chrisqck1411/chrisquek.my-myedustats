---
import Base from '../layouts/Base.astro';
import register from '../content/terms.json';

// Review page for the terminology register. English only, not linked from the site, never indexed.
// It will be replaced by the public bilingual glossary in the last slice.
const terms = register.terms;
const flagged = terms.filter((t) => t.status === 'flagged');
const needsChoice = terms.filter((t) => t.status === 'sourced' && (t.alternatives?.length ?? 0) > 0);
const sourced = terms.filter((t) => t.status === 'sourced');

const categoryNames: Record<string, string> = {
  role: 'Header role names',
  stage: 'Education stages',
  institution: 'Schools and institutions',
  measure: 'Measures',
  person: 'People in education',
  breakdown: 'Breakdowns (sex, citizenship)',
  geography: 'Places and levels',
  organisation: 'Organisations',
};
const order = Object.keys(categoryNames);
const groups = order
  .map((key) => ({ key, name: categoryNames[key], items: sourced.filter((t) => t.category === key) }))
  .filter((g) => g.items.length > 0);
---

<Base lang="en" path="terms/" title="Terminology register (review)" noindex singleLanguage>
  <h1>Terminology register</h1>
  <p class="lead">
    Review page for Chris. Every Bahasa Melayu term used on the site, with the official source it comes from.
    Tier 1 is the dataset's own Malay page, tier 2 is Ministry of Education or DOSM, tier 3 is the DBP dictionary.
  </p>
  <p class="term-meta">{sourced.length} sourced, {flagged.length} flagged, {needsChoice.length} with an alternative to choose from. Register updated {register.updated}.</p>

  <section aria-labelledby="flagged-h">
    <h2 id="flagged-h">Needs your decision</h2>
    {flagged.length === 0 && <p>Nothing is flagged.</p>}
    {flagged.map((t) => (
      <article class="term-card term-flag" id={t.id}>
        <h3>{t.en}</h3>
        <p class="term-ms">Draft BM on the site: <strong>{t.ms_draft}</strong> (not sourced)</p>
        <p>{t.note}</p>
      </article>
    ))}
    {needsChoice.map((t) => (
      <article class="term-card term-flag" id={`choice-${t.id}`}>
        <h3>{t.en}</h3>
        <p class="term-ms">Current: <strong>{t.ms}</strong></p>
        <ul class="term-sources">
          {t.alternatives.map((a) => (
            <li>
              Also used officially: <strong>{a.ms}</strong>. {a.note}
              {a.sources.map((s) => (<> <a href={s.url}>{s.label}</a> (tier {s.tier})</>))}
            </li>
          ))}
        </ul>
        {t.note && <p>{t.note}</p>}
      </article>
    ))}
  </section>

  {groups.map((g) => (
    <section aria-labelledby={`h-${g.key}`}>
      <h2 id={`h-${g.key}`}>{g.name}</h2>
      {g.items.map((t) => (
        <article class="term-card" id={t.id}>
          <h3>
            <span class="term-en">{t.en}</span>
            <span class="term-arrow" aria-hidden="true">→</span>
            <span class="term-ms" lang="ms">{t.ms}</span>
          </h3>
          {t.definition_ms && <p class="term-def" lang="ms">{t.definition_ms}</p>}
          {t.note && <p class="term-note">{t.note}</p>}
          <ul class="term-sources">
            {t.sources.map((s) => (
              <li><a href={s.url}>{s.label}</a> (tier {s.tier}): <span lang="ms">“{s.quote}”</span></li>
            ))}
          </ul>
        </article>
      ))}
    </section>
  ))}
</Base>
