    {
      "status": "sourced",
      "id": "education-stage",
      "category": "stage",
      "en": "Education stage",
      "ms": "Peringkat pendidikan",
      "note": "Chris chose \"Peringkat pendidikan\" for the whole site on 23 Nov 2026. It is the Ministry of Education and DOSM wording for the stages. \"Tahap\" has a fixed meaning inside primary school (Tahap 1 = Years 1 to 3, Tahap 2 = Years 4 to 6), so it would confuse readers. Where a chart, source line or CSV download shows a dataset's own column name, the dataset's wording \"Tahap Pendidikan\" is kept.",
      "alternatives": [
        {
          "ms": "Tahap pendidikan",
          "note": "The dataset pages call the column \"Tahap Pendidikan\" in their variable tables. Keep this wording only where the site shows a dataset's own column name (CSV headers, \"source column\" lines).",
          "sources": [
            {
              "tier": 1,
              "label": "OpenDOSM dataset page (BM): schools_district",
              "url": "https://open.dosm.gov.my/ms-MY/data-catalogue/schools_district",
              "quote": "Tahap Pendidikan"
            }
          ]
        }
      ],
      "sources": [
        {
          "tier": 1,
          "label": "OpenDOSM dataset metadata (BM chart labels): enrolment_school_district",
          "url": "https://open.dosm.gov.my/ms-MY/data-catalogue/enrolment_school_district",
          "quote": "Peringkat Pendidikan"
        },
        {
          "tier": 2,
          "label": "Ministry of Education: National Education Policy book, 4th edition",
          "url": "https://www.moe.gov.my/storage/files/shares/Dasar/Dasar%20Pendidikan%20Kebangsaan/Dasar%20Pendidikan%20Kebangsaan%20Edisi%20Keempat.pdf",
          "quote": "Peringkat pendidikan di Malaysia adalah daripada peringkat prasekolah"
        }
      ],
      "evidence": [
        {
          "point": "In Ministry of Education usage \"Tahap\" is also a fixed name for half of primary school: Tahap 1 is Years 1 to 3, Tahap 2 is Years 4 to 6. It also means a mastery level.",
          "tier": 2,
          "label": "Ministry of Education: school-based assessment guide 2025",
          "url": "https://www.moe.gov.my/storage/files/shares/pekeliling_dan_garis_panduan/Panduan%20Pengurusan%20PBS%20Edisi%201%20Tahun%202025.pdf",
          "quote": "Murid Tahap 1 (Tahun 1, Tahun 2 dan Tahun 3)"
        }
      ],
      "decision": {
        "by": "Chris",
        "on": "2026-11-23",
        "choice": "Peringkat pendidikan"
      }
    },
    {
      "status": "sourced",
      "id": "primary-year",
      "category": "stage",
      "en": "Year (primary year group)",
      "ms": "Tahun",
      "note": "Chris chose the newer Ministry of Education wording in both languages (23 Nov 2026). In English the Ministry writes \"Year 1\" to \"Year 6\"; \"Standard 1\" to \"Standard 6\" is the older wording, still used by the OpenDOSM English dataset page. The datasets' Malay pages still say \"Darjah\".",
      "evidence": [
        {
          "point": "Ministry of Education English wording: primary year groups are \"Year 1\" to \"Year 6\" (Malaysia Education Blueprint Annual Report 2013).",
          "tier": 2,
          "label": "Ministry of Education: Malaysia Education Blueprint Annual Report 2013",
          "url": "https://pppm.moe.gov.my/dokumen/27-lt2013-en/file",
          "lang": "en",
          "quote": "English language literacy screening was implemented for Year 1 students"
        },
        {
          "point": "The Ministry's English \"Education Direction\" page writes \"year 1 to year 6\" from its 1989 entry; \"Standard\" appears there only in entries from 1967 to 1973.",
          "tier": 2,
          "label": "Ministry of Education: Education Direction (English)",
          "url": "https://www.moe.gov.my/en/dasarmenu/hala-tuju-pendidikan",
          "lang": "en",
          "quote": "in year 1 to year 6 of all primary schools"
        },
        {
          "point": "The older English wording \"Standards 1 to 6\", still on the OpenDOSM English dataset page (checked 23 Nov 2026). Not used on this site.",
          "tier": 1,
          "label": "OpenDOSM dataset page (English): enrolment_school_district",
          "url": "https://open.dosm.gov.my/data-catalogue/enrolment_school_district",
          "lang": "en",
          "quote": "primary (Standards 1 to 6)"
        }
      ],
      "alternatives": [
        {
          "ms": "Darjah",
          "note": "Wording used in the OpenDOSM dataset descriptions.",
          "sources": [
            {
              "tier": 1,
              "label": "OpenDOSM dataset page (BM): enrolment_school_district",
              "url": "https://open.dosm.gov.my/ms-MY/data-catalogue/enrolment_school_district",
              "quote": "pendidikan rendah (Darjah 1 hingga 6)"
            }
          ]
        }
      ],
      "sources": [
