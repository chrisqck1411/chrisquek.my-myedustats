---
import Base from '../layouts/Base.astro';
import GlanceCard from './GlanceCard.astro';
import QuestionCard from './QuestionCard.astro';
import { t, type Lang } from '../i18n';
import { buildCards } from '../lib/glance';
import { buildQuestion, QUESTION_IDS } from '../lib/questions';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const cards = buildCards(lang);
const questions = QUESTION_IDS.map((id) => buildQuestion(id, lang));
---

<Base lang={lang} path="">
  <div class="hero">
    <div class="hero-mascot">
      <img
        id="mascot"
        src="/mascot/default.webp"
        width="499"
        height="700"
        alt={t(lang, 'mascot.alt')}
        data-alt={t(lang, 'mascot.alt')}
      />
    </div>
    <div class="hero-text">
      <h1>{t(lang, 'site.name')}</h1>
      <p class="lead">{t(lang, 'site.tagline')}</p>
      <p class="notice">{t(lang, 'site.status')}</p>
    </div>
  </div>
  <section class="questions" id="questions" aria-labelledby="questions-title">
    <h2 id="questions-title">{t(lang, 'home.questions.title')}</h2>
    <p class="section-lead">{t(lang, 'home.questions.lead')}</p>
    <div class="card-grid">
      {questions.map((question) => <QuestionCard lang={lang} question={question} />)}
    </div>
  </section>
  <section class="glance" id="glance" aria-labelledby="glance-title">
    <h2 id="glance-title">{t(lang, 'glance.title')}</h2>
    <div class="card-grid">
      {cards.map((card) => <GlanceCard lang={lang} card={card} />)}
    </div>
  </section>
</Base>
