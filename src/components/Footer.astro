---
import { t, type Lang } from '../i18n';
import { FEEDBACK_EMAIL } from '../config';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
---

<footer class="site-footer">
  <div class="wrap">
    <p>{t(lang, 'footer.data')}</p>
    <p>{t(lang, 'footer.unofficial')}</p>
    <p>{t(lang, 'footer.feedback')}: <a href={`mailto:${FEEDBACK_EMAIL}`}>{FEEDBACK_EMAIL}</a></p>
  </div>
</footer>
